# Copy to .env; replace this placeholder with a locally generated secret.
SECRET_KEY=replace-with-a-random-local-secret
APP_ENV=development
SESSION_COOKIE_SECURE=false
# Production requires explicit comma-separated hostnames; see docs/deployment.md.
TRUSTED_HOSTS=
# Only enable after verifying your trusted proxy chain; local requests trust none.
PROXY_FIX_X_FOR=0
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=900
# Browser cookie lifetime in seconds (180 days); database retention is separate.
STUDENT_COOKIE_MAX_AGE=15552000

# TrustServerCertificate=yes is ONLY for these local self-signed containers.
# Production requires TrustServerCertificate=no and an Azure SQL hostname.
# Local Docker credentials only. Do not reuse these for any hosted database.
DATABASE_URL=mssql+pyodbc://takeanumber_dev:Local_Dev_Only_42!@127.0.0.1:55432/takeanumber_dev?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
TEST_DATABASE_URL=mssql+pyodbc://takeanumber_test:Local_Test_Only_42!@127.0.0.1:55433/takeanumber_test?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
