# Copy to .env; replace this placeholder with a locally generated secret.
SECRET_KEY=replace-with-a-random-local-secret
SESSION_COOKIE_SECURE=false
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=900

# Local Docker credentials only. Do not reuse these for any hosted database.
DATABASE_URL=postgresql+psycopg://takeanumber_dev:local_dev_only@127.0.0.1:55432/takeanumber_dev
TEST_DATABASE_URL=postgresql+psycopg://takeanumber_test:local_test_only@127.0.0.1:55433/takeanumber_test
